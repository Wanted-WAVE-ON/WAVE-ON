# SilentOrchestra 2.0
SO_DATABASE_URL=sqlite:///./data/silent_orchestra.db
SO_SUGGESTION_THRESHOLD=3
SO_AUTO_EXECUTION_THRESHOLD=0.60
SO_ENABLE_OS_ACTIONS=false
# 실제 OS 실행 전 대상 앱이 활성 창인지 확인합니다. Linux 등 확인이 불가능한 환경에서만 false로 둡니다.
SO_REQUIRE_ACTIVE_WINDOW=true
# demo-user 초기화 API 허용 여부입니다. 데모 외 환경에서는 false로 둡니다.
SO_DEMO_MODE=true
SO_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
